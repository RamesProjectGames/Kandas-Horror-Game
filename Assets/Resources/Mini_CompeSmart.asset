  dialogues:
  - speaker: Competitive Student
    dialogue:
    - dialogue: How did you do on the quiz?
      segmentSignal: 0
      signalDelay: 0
    functions: []
  - speaker: Smart Student
    dialogue:
    - dialogue: It was easy.
      segmentSignal: 0
      signalDelay: 0
    functions: []
  - speaker: Competitive Student
    dialogue:
    - dialogue: "I don\u2019t believe you."
      segmentSignal: 0
      signalDelay: 0
    - dialogue: " Didn\u2019t you say yesterday you were up all night playing games?"
      segmentSignal: 1
      signalDelay: 0
    functions: []
  - speaker: Smart Student
    dialogue:
    - dialogue: "Yeah that\u2019s true, what about it?"
      segmentSignal: 0
      signalDelay: 0
    functions: []
  - speaker: Competitive Student
    dialogue:
    - dialogue: "There\u2019s no way you had time to study."
      segmentSignal: 0
      signalDelay: 0
    functions: []
  - speaker: Smart Student
    dialogue:
    - dialogue: I did, actually. The game I was playing actually helped me study.
      segmentSignal: 0
      signalDelay: 0
    functions: []
  - speaker: Competitive Student
    dialogue:
    - dialogue: What do you mean by that?
      segmentSignal: 0
      signalDelay: 0
    functions: []
  - speaker: Smart Student
    dialogue:
    - dialogue: Have you ever heard of Learn It Up?
      segmentSignal: 0
      signalDelay: 0
    - dialogue: " It\u2019s an educational game where you can answer quizzes and
        learn school subjects."
      segmentSignal: 1
      signalDelay: 0
    - dialogue: You can even roam around the school and do some quests.
      segmentSignal: 0
      signalDelay: 0
    functions: []
  - speaker: Competitive Student
    dialogue:
    - dialogue: ...
      segmentSignal: 0
      signalDelay: 0
    - dialogue: Even your games are educational. Is this the key on getting good
        grades?
      segmentSignal: 0
      signalDelay: 0
    functions: []
