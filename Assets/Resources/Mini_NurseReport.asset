  dialogues:
  - speaker: Narration
    dialogue:
    - dialogue: There seems to be a staff complaint form addressed to the principal.
      segmentSignal: 0
      signalDelay: 0
    - dialogue: \nIt's drafted by the nurse
      segmentSignal: 1
      signalDelay: 0
    functions: []
  - speaker: Nurse
    dialogue:
    - dialogue: "Dear Mister Principal, I need to report to you regarding the abundance
        of students faking illness in order to get out class. This is a matter of
        our students\u2019 discipline."
      segmentSignal: 0
      signalDelay: 0
    - dialogue: ' I hope you will address this in the next school board meeting so
        we can collectively come up with a viable solution.'
      segmentSignal: 1
      signalDelay: 0
    functions: []
