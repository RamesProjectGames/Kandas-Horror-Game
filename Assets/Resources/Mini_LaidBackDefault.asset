  m_Script: {fileID: 11500000, guid: c4bfecec6846a9d4286bc9ad6f3ffac5, type: 3}
  m_Name: Mini_LaidBackDefault
  m_EditorClassIdentifier: Assembly-CSharp:Dialogue:MiniConvo
  convoName: Mini_LaidBackDefault
  dialogues:
  - speaker: Laid-Back Student
    dialogue:
    - dialogue: The school's backyards is quiet and people rarely go there except
        to ditch classes. However, recently the teachers caught on with what's happening,
        so the school closed it off.
      segmentSignal: 0
      signalDelay: 0
    - dialogue: It doesn't matter though, there's actually a pretty big hole on one
        of the gate's corners because some animal chewed its way through the wires.
        You can slip through there just fine.
      segmentSignal: 0
      signalDelay: 0
    - dialogue: "It's covered by a lot of bushes, but be careful not to get caught
        while you\u2019re on the way."
      segmentSignal: 0
      signalDelay: 0
    functions: []
