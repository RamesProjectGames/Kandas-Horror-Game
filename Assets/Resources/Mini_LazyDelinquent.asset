--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c4bfecec6846a9d4286bc9ad6f3ffac5, type: 3}
  m_Name: Mini_LazyDelinquent
  m_EditorClassIdentifier: 
  convoName: Mini_LazyDelinquent
  dialogues:
  - speaker: Lazy Student
    dialogue:
    - dialogue: "Yo, want to ditch the next period together? It\u2019s Mr. Yusuf\u2019s
        class. Old man never stops yapping about all that Science mumbo jumbo research
        and the importance like bruh..."
      segmentSignal: 0
      signalDelay: 0
    - dialogue: ' Who cares, you know?'
      segmentSignal: 4
      signalDelay: 0.5
    functions: []
  - speaker: Delinquent Student
    dialogue:
    - dialogue: "Ugh, tell me about it. A shame they sealed off the school\u2019s
        backyard entrance."
      segmentSignal: 0
      signalDelay: 0
    - dialogue: ' I guess too many of us went there to ditch classes. Who even shared
        our secret hideout?'
      segmentSignal: 2
      signalDelay: 0
    functions: []
  - speaker: Lazy Student
    dialogue:
    - dialogue: "Actually, it\u2019s an open secret. We\u2019re not the only ones
        going there."
      segmentSignal: 0
      signalDelay: 0
    - dialogue: \nFortunately unlike most of us bandwagons, our classmate knows another
        route to get to the backyard.
      segmentSignal: 2
      signalDelay: 0
    - dialogue: " You know, the one that\u2019s always chill."
      segmentSignal: 2
      signalDelay: 0
    functions: []
  - speaker: Delinquent Student
    dialogue:
    - dialogue: Well, spill the tea, how would you do that?
      segmentSignal: 0
      signalDelay: 0
    functions: []
  - speaker: Lazy Student
    dialogue:
    - dialogue: Too tired to explain, ask him yourself.
      segmentSignal: 0
      signalDelay: 0
    - dialogue: ' He always hangs out around the school cafeteria.'
      segmentSignal: 2
      signalDelay: 0
    functions: []
