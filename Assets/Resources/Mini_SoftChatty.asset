  dialogues:
  - speaker: Soft-Spoken Student
    dialogue:
    - dialogue: My mom bought me a birthday gift yesterday.
      segmentSignal: 0
      signalDelay: 0
    functions: []
  - speaker: Chatty Student
    dialogue:
    - dialogue: Wow, how nice!
      segmentSignal: 0
      signalDelay: 0
    - dialogue: ' So, what did she get you?'
      segmentSignal: 4
      signalDelay: 0.2
    functions: []
  - speaker: Soft-Spoken Student
    dialogue:
    - dialogue: "She got me a new handbag I\u2019ve been eyeing for a while."
      segmentSignal: 0
      signalDelay: 0
    functions: []
  - speaker: Chatty Student
    dialogue:
    - dialogue: "That\u2019s awesome!"
      segmentSignal: 0
      signalDelay: 0
    - dialogue: " But you don\u2019t seem to be pleased, is everything alright?"
      segmentSignal: 4
      signalDelay: 0.2
    functions: []
  - speaker: Soft-Spoken Student
    dialogue:
    - dialogue: "Yeah, but... the thing is, I\u2019ve been eyeing that handbag because
        I wanted to gift it to her on her birthday."
      segmentSignal: 0
      signalDelay: 0
    - dialogue: But she ended up buying it for me instead...
      segmentSignal: 1
      signalDelay: 0
    functions: []
  - speaker: Chatty Student
    dialogue:
    - dialogue: ...
      segmentSignal: 0
      signalDelay: 0
    - dialogue: You and your mom really care for each other.
      segmentSignal: 1
      signalDelay: 0
    functions: []
