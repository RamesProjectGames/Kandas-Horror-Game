      segmentSignal: 0
      signalDelay: 0
    functions: []
  - speaker: Jessica
    dialogue:
    - dialogue: "I didn\u2019t know we have homework."
      segmentSignal: 0
      signalDelay: 0
    - dialogue: ' I just moved here today.'
      segmentSignal: 3
      signalDelay: 0.2
    functions: []
  - speaker: Studying Student
    dialogue:
    - dialogue: No, no, haha, this is a special worksheet from the teacher.
      segmentSignal: 0
      signalDelay: 0
    - dialogue: " I\u2019m studying to compete in a science competition next week."
      segmentSignal: 1
      signalDelay: 0
    - dialogue: " So I\u2019ve been given a lot of studying materials."
      segmentSignal: 3
      signalDelay: 0.2
    - dialogue: "Don\u2019t worry about it."
      segmentSignal: 0
      signalDelay: 0
    - dialogue: " But, if you have any questions about any subjects, you can ask
        me! I\u2019ll tutor you!"
      segmentSignal: 3
      signalDelay: 0.2
    functions: []
