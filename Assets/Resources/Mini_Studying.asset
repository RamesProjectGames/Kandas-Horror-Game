  dialogues:
  - speaker: Studying Student
    dialogue:
    - dialogue: Hello, what do you need?
      segmentSignal: 0
      signalDelay: 0
    functions: []
  - speaker: Jessica
    dialogue:
    - dialogue: What are you doing here?
      segmentSignal: 0
      signalDelay: 0
    functions: []
  - speaker: Studying Student
    dialogue:
    - dialogue: You mean what am I doing in the library?
      segmentSignal: 0
      signalDelay: 0
    - dialogue: "Hahaha, you\u2019re funny. Of course I\u2019m studying."
      segmentSignal: 0
      signalDelay: 0
    functions: []
  - speaker: Jessica
    dialogue:
    - dialogue: "Isn\u2019t it breaktime?"
      segmentSignal: 0
      signalDelay: 0
    functions: []
  - speaker: Studying Student
    dialogue:
    - dialogue: Oh, I know. But I already ate a little and I have to finish this
