%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c4bfecec6846a9d4286bc9ad6f3ffac5, type: 3}
  m_Name: Mini_Laidback
  m_EditorClassIdentifier: Assembly-CSharp:Dialogue:MiniConvo
  convoName: Mini_Laidback
  dialogues:
  - rawLine: 
    speaker: Laid-Back Student
    dialogue:
    - dialogue: Hey, are you the new kid from class 11-B?
      segmentSignal: 0
      signalDelay: 0
    functions: []
  - rawLine: 
    speaker: Jessica
    dialogue:
    - dialogue: "Yes, that\u2019s me."
      segmentSignal: 0
      signalDelay: 0
    functions: []
  - rawLine: 
    speaker: Laid-Back Student
    dialogue:
    - dialogue: I see, wanna hang out with me alone?
      segmentSignal: 0
      signalDelay: 0
    functions: []
  - rawLine: 
    speaker: Jessica
    dialogue:
    - dialogue: Umm....
      segmentSignal: 0
      signalDelay: 0
    functions: []
  - rawLine: 
    speaker: Laid-Back Student
    dialogue:
    - dialogue: Just kidding. Relax a little. You look like you could use a break.
      segmentSignal: 0
      signalDelay: 0
    - dialogue: I'll tell you a secret. I know a good spot to ditch class to take
        a breather.
      segmentSignal: 0
      signalDelay: 0
    - dialogue: The school's backyards are quiet and people rarely go there except
        to ditch classes.
      segmentSignal: 0
      signalDelay: 0
    - dialogue: ' However, recently the teachers caught on with what''s happening,
        so the school closed it off.'
      segmentSignal: 1
      signalDelay: 0
    - dialogue: It doesn't matter though, what they don't realize that some animal
        chewed its way through the wires and there's actually a pretty big hole on
        one of the gate's corners. You can slip through there just fine.
      segmentSignal: 0
      signalDelay: 0
    - dialogue: It's covered by a lot of bushes, but that's good because the teachers
        and the security guy wouldn't notice it.
      segmentSignal: 0
      signalDelay: 0
    - dialogue: "Just be careful not to get caught while you\u2019re on the way,"
      segmentSignal: 0
      signalDelay: 0
    - dialogue: " you\u2019re not seeing the end of it if you do."
      segmentSignal: 3
      signalDelay: 0.5
    - dialogue: "That\u2019s all from me, see ya around~"
      segmentSignal: 0
      signalDelay: 0
    functions:
    - name: Objective
      args:
      - LaidBack
      waitForCompletion: 0
